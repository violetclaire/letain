# Local preview placeholders only. Do not commit real secrets.
#
# npm run dev:server loads .env.local for local preview. If .env.local is
# absent, it falls back to .env. Existing shell-provided values for these
# variables still win over file values.

# Use a staging or disposable database for local preview. Backend startup may
# run additive DB setup against the configured database.
NEON_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME

SESSION_SECRET=replace-with-a-local-development-secret
PUBLIC_BASE_URL=http://localhost:5173
PORT=5001
DEV_SERVER_HOST=127.0.0.1
VITE_API_PROXY_TARGET=http://localhost:5001
# Local preview should leave reusePort disabled unless you explicitly need it.
# DEV_SERVER_REUSE_PORT=true

# Current login/logout/callback behavior remains Replit OIDC-backed.
REPL_ID=replace-with-current-replit-oidc-client-id-if-using-oidc-login
ISSUER_URL=https://replit.com/oidc
# Optional local-only fallback for previewing with seeded email/password login
# when Replit OIDC discovery is unavailable. Do not set in production.
# LOCAL_AUTH_BYPASS=true

# Local demo seed is opt-in and must target disposable/staging data only.
# Do not set these for production.
# ALLOW_LOCAL_DEMO_SEED=true
# LOCAL_DEMO_DB_CONFIRM=disposable
# DEMO_OPERATOR_PASSWORD=replace-with-local-demo-password
# DEMO_SEED_ACTION=cleanup
